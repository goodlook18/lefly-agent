{
  "name": "@lefly/console-web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test scripts/run-simulator.test.mjs scripts/run-m3-stack.test.mjs scripts/run-e2e.test.mjs && vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:visual": "playwright test --config playwright.visual.config.ts"
  },
  "dependencies": {
    "lucide-react": "0.539.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
